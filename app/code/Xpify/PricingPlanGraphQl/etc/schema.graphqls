
type Query {
    pricingPlans: [PricingPlan] @doc(description: "Get all pricing plans for an app") @resolver(class: "Xpify\\PricingPlanGraphQl\\Model\\Resolver\\AppPricingPlanQuery")
    pricingPlan(id: ID!): PricingPlan @doc(description: "Get a pricing plan by ID") @resolver(class: "Xpify\\PricingPlanGraphQl\\Model\\Resolver\\PricingPlanQuery")
}

type Interval {
    interval: String! @doc(description: "Interval type. One of: ONE_TIME, EVERY_30_DAYS, ANNUAL")
    amount: Float!
    compare_at_price: Float @doc(description: "Price before discount")
}

enum BadgeTone {
    INFO @doc(description: "Blue badge tone")
    SUCCESS @doc(description: "Green badge tone")
    WARNING @doc(description: "Yellow badge tone")
    CRITICAL @doc(description: "Red badge tone")
    ATTENTION @doc(description: "Orange badge tone")
    NEW @doc(description: "New badge tone")
    MAGIC @doc(description: "Purple badge tone")
    INFO_STRONG @doc(description: "Strong blue badge tone")
    SUCCESS_STRONG @doc(description: "Strong green badge tone")
    WARNING_STRONG @doc(description: "Strong yellow badge tone")
    CRITICAL_STRONG @doc(description: "Strong red badge tone")
    ATTENTION_STRONG @doc(description: "Strong orange badge tone")
    READ_ONLY @doc(description: "Read-only badge tone")
    ENABLED @doc(description: "Enabled badge tone")
}
type Badge {
    content: String! @doc(description: "Badge content")
    tone: BadgeTone! @doc(description: "Badge color in hex format")
}

type PricingPlan {
    id: ID!
    status: Boolean!
    code: String!
    name: String!
    prices: [Interval] @doc(description: "Prices for each interval")
    badges: [Badge] @doc(description: "Badges associated with the pricing plan")
    currency: String! @doc(description: "Currency code. Currently only USD is supported")
    free_trial_days: Int @doc(description: "Number of free trial days")
    short_description: String @doc(description: "Short description of the pricing plan")
    description: String
    sort_order: Int
}

enum PricingPlanStatus {
    PENDING @doc(description: "The app subscription is pending approval by the merchant.")
    ACCEPTED @doc(description: "The app subscription has been approved by the merchant and is ready to be activated by the app.")
    ACTIVE @doc(description: "The app subscription has been approved by the merchant. Active app subscriptions are billed to the shop. After payment, partners receive payouts.")
    DECLINED @doc(description: "The app subscription was declined by the merchant. This is a terminal state.")
    EXPIRED @doc(description: "The app subscription wasn't approved by the merchant within two days of being created. This is a terminal state.")
    FROZEN @doc(description: "The app subscription is on hold due to non-payment. The subscription re-activates after payments resume.")
    CANCELLED @doc(description: "The app subscription was cancelled by the app. This could be caused by the app being uninstalled, a new app subscription being activated, or a direct cancellation by the app. This is a terminal state.")
    DEACTIVATED @doc(description: "The plan is deactivated")
}
type ActivePricingPlan {
    id: ID!
    code: String!
    name: String!
    price: Float!
    interval: PricingPlanInterval!
    created_at: String!
    status:PricingPlanStatus
}

type Shop {
    activePlan: ActivePricingPlan @doc(description: "The currently active pricing plan for the shop") @resolver(class: "Xpify\\PricingPlanGraphQl\\Model\\Resolver\\ActivePlanResolver")
}
