<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">xpify_appfeature_form.xpify_appfeature_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">App Feature Information</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Xpify\AppFeature\Block\Adminhtml\Feature\Edit\SaveButton"/>
            <button name="delete" class="Xpify\AppFeature\Block\Adminhtml\Feature\Edit\DeleteButton"/>
        </buttons>
        <namespace>xpify_appfeature_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>xpify_appfeature_form.xpify_appfeature_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="xpify_appfeature_form_data_source" component="Magento_Ui/js/form/provider">
        <settings>
            <submitUrl path="xpify_appfeature/feature/save"/>
        </settings>
        <dataProvider class="Xpify\AppFeature\Ui\Component\Form\FeatureDataProvider" name="xpify_appfeature_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">General Information</label>
        </settings>
        <field name="entity_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feature</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="feature_key" sortOrder="10" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feature</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-code" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Feature Key</label>
                <dataScope>feature_key</dataScope>
            </settings>
        </field>
        <field name="feature_name" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feature</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Feature Name</label>
                <dataScope>feature_name</dataScope>
            </settings>
        </field>
        <field name="description" sortOrder="30" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feature</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
        </field>
        <field name="required_version" sortOrder="40" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feature</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Required Version</label>
                <dataScope>required_version</dataScope>
                <notice translate="true">Minimum app version required for this feature (e.g. 1.0.0). Leave empty for no version requirement.</notice>
            </settings>
        </field>
        <field name="is_enabled_by_default" sortOrder="50" formElement="checkbox">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">feature</item>
                    <item name="default" xsi:type="number">0</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Enabled by Default</label>
                <dataScope>is_enabled_by_default</dataScope>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="number">0</map>
                            <map name="true" xsi:type="number">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
    </fieldset>
</form>